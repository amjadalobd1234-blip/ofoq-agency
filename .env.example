# =============================================================================
#  أفق | Ofoq — environment configuration
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in what you have.
#  EVERY value below is optional except APP_URL / AUTH_SECRET for production.
#  Nothing here is a real key: all integrations default to a DISABLED state and
#  the platform runs fully without them (see docs/INTEGRATIONS.md).
# =============================================================================

# --- Application -------------------------------------------------------------
# Public base URL used in emails, links and OAuth redirects.
APP_URL="http://localhost:3000"
# Intended production domain. CONFIGURATION ONLY — it is not assumed to be
# purchased, delegated or connected. Change it freely.
APP_DOMAIN="ofaq.com"
APP_NAME_AR="أفق"
APP_NAME_EN="Ofoq"
# Default fallback locale: ar | en
APP_DEFAULT_LOCALE="ar"
# Node environment: development | production | test
NODE_ENV="development"

# --- Database ----------------------------------------------------------------
# sqlite (default, zero-setup, file based) or postgres (production scale-out).
DATABASE_DRIVER="sqlite"
# Used when DATABASE_DRIVER=sqlite. Relative paths resolve from the project root.
SQLITE_PATH="./data/ofoq.sqlite"
# Used when DATABASE_DRIVER=postgres. The `pg` driver is included.
# For Supabase/Vercel setup and generated migrations, see docs/DEPLOY-AR.md.
# DATABASE_URL="postgres://user:password@localhost:5432/ofoq"

# --- Auth & security (REQUIRED for production) -------------------------------
# 32+ random bytes. Generate with:  openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-please-32bytes-min"
# Session lifetime in hours.
AUTH_SESSION_TTL_HOURS="168"
# Enables the secure flag on auth cookies. Set to false only for local http dev.
AUTH_COOKIE_SECURE="false"
# 32 bytes, base64 — encrypts third-party OAuth tokens at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Comma separated list; when empty the platform falls back to APP_URL.
AUTH_TRUSTED_ORIGINS=""

# --- Google sign-in (optional — disabled until provided) ---------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI model provider (optional — disabled until provided) ------------------
# none | openai_compatible
#   none              → the built-in deterministic rules engine handles the
#                       assistant, pricing and agent workflows (no external calls).
#   openai_compatible → any OpenAI-compatible endpoint (OpenAI, Azure OpenAI,
#                       OpenRouter, Groq, Together, local vLLM/Ollama, …).
AI_PROVIDER="none"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_TEMPERATURE="0.3"
AI_MAX_TOKENS="1200"
AI_TIMEOUT_MS="30000"

# --- Email (optional — dev transport logs to the database outbox) ------------
# console | smtp | resend
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@ofaq.com"
EMAIL_FROM_NAME="أفق | Ofoq"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
RESEND_API_KEY=""

# --- Payments (optional — manual/invoice flow is the default) ---------------
# manual | stripe
#   manual → invoices are settled by recording a manual payment (bank transfer,
#            cash, local wallet) after human confirmation.
#   stripe → ONLINE CARD PAYMENTS ARE NOT ENABLED YET. The adapter exists but has
#            never been executed against a live Stripe account; it stays disabled
#            until it is implemented and verified with real keys.
PAYMENTS_PROVIDER="manual"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
DEFAULT_CURRENCY="USD"

# --- Google Ads (NOT CONNECTED — integration scaffold only) -----------------
# No Google Ads account exists yet. Leave disabled; see docs/INTEGRATIONS.md.
GOOGLE_ADS_ENABLED="false"
GOOGLE_ADS_API_VERSION="v18"
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# --- WhatsApp Business (NOT CONNECTED — integration scaffold only) ----------
WHATSAPP_ENABLED="false"
# meta_cloud
WHATSAPP_PROVIDER="meta_cloud"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# --- Automation / jobs -------------------------------------------------------
# Protects /api/cron/* endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=""
# Hour (tenant-local, 0-23) at which daily campaign reports are assembled.
DAILY_REPORT_HOUR="7"

# --- Seeding (development only) ---------------------------------------------
# When "true", `npm run db:seed` inserts clearly-labelled DEMO records.
# Never enable in production; `npm run db:reset -- --demo` removes them.
SEED_DEMO_DATA="false"
