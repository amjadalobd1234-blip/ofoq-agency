TTS_ENGINE=piper
TTS_VOICE=ar_JO-kareem-medium
TTS_RATE=1.0
TTS_MODEL_DIR=models/piper

AVATAR_ENGINE=sadtalker
AVATAR_MODE=sadtalker
DEFAULT_AVATAR=assets/avatars/man-1.png
SADTALKER_DIR=/content/SadTalker
SADTALKER_PYTHON=.venv-sadtalker/bin/python
AVATAR_DEVICE=cpu

PYTHON_BIN=python3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional: installed Chrome/Chromium executable. No browser downloads at runtime.
# Leave this empty to auto-detect, in order: PUPPETEER_EXECUTABLE_PATH,
# /usr/bin/chromium-browser, /usr/bin/chromium, /usr/bin/google-chrome, /usr/bin/google-chrome-stable.
# Set it only when your browser lives somewhere else, e.g.
# BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BROWSER_EXECUTABLE=
# PUPPETEER_EXECUTABLE_PATH=
OUTPUT_DIR=output/
FPS=30
WIDTH=1080
HEIGHT=1080
TEMPLATE_LANG=ar
# Optional locally installed/licensed WOFF2 font in assets/fonts/.
FONT_FILE=
