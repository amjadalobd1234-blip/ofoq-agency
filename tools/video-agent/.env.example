TTS_ENGINE=piper
TTS_VOICE=ar_JO-kareem-medium
TTS_RATE=1.0
TTS_MODEL_DIR=models/piper

AVATAR_ENGINE=sadtalker
DEFAULT_AVATAR=assets/avatars/man-1.png
SADTALKER_DIR=vendor/SadTalker
SADTALKER_PYTHON=.venv-sadtalker/bin/python
AVATAR_DEVICE=cpu

PYTHON_BIN=python3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Required: installed Chrome/Chromium executable; no browser downloads at runtime.
BROWSER_EXECUTABLE=/usr/bin/chromium
OUTPUT_DIR=output/
FPS=30
WIDTH=1080
HEIGHT=1080
TEMPLATE_LANG=ar
# Optional locally installed/licensed WOFF2 font in assets/fonts/.
FONT_FILE=
